[flake8]
max-line-length = 100
extend-ignore = [
    # Whitespace before : (conflicts with Black formatting)
    E203,
    # Line break before binary operator (conflicts with Black)
    W503,
    # Line too long (already handled by max-line-length)
    E501,
]
exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    .eggs,
    *.egg-info,
    .mypy_cache,
    .pytest_cache,
per-file-ignores =
    # Ignore "imported but unused" warnings in __init__.py files
    __init__.py:F401
